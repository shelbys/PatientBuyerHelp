{
  "name": "PatientBuyerHelp",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "pnpm --reporter silent lint",
    "clean": "rimraf pnpm-lock.yaml node_modules",
    "dev": "nodemon",
    "lint": "pnpm --reporter silent lint-eslint && pnpm --reporter silent lint-prettier",
    "lint-eslint": "eslint --ignore-pattern .vscode --ignore-pattern coverage/ --ignore-pattern dist/",
    "lint-fix": "prettier --write **/*.{css,html,js,json,jsx,md}",
    "lint-prettier": "prettier -c **/*.{js,json,md}",
    "upgrade": "pnpm up --latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "mocha": "^11.8.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3"
  },
  "nodemonConfig": {
    "ignore": [
      ".vscode/*"
    ],
    "watch": [
      "**"
    ],
    "exec": "pnpm build",
    "ext": "css,html,js,jsx,json,md,svg,yml"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 120,
    "proseWrap": "always",
    "objectWrap": "preserve",
    "semi": true,
    "singleQuote": true,
    "trailingComma": "none"
  }
}
